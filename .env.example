# 复制成 .env 后按实际情况填写（.env 已在 .gitignore 中，不会被提交）

# ---------- 大模型（OpenAI 兼容接口） ----------
LLM_API_KEY=sk-xxxx
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT=60

# ---------- 数据库 ----------
# 不填就用项目根目录下的 SQLite（dev_agent.db），开箱即跑
# DATABASE_URL=mysql+aiomysql://root:password@127.0.0.1:3306/agent_db?charset=utf8mb4
DB_ECHO=false

# ---------- 鉴权 ----------
# 生产环境必须换成随机长串，例如 python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720

# ---------- 检索 ----------
KNOWLEDGE_DIR=knowledge_base
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
RAG_TOP_K=3
RAG_DENSE_THRESHOLD=0.55
RAG_DENSE_FLOOR=0.45
RAG_RRF_K=60
RAG_CANDIDATE_POOL=10

# ---------- 记忆 ----------
# 最近几轮原文的 token 预算（估算值，中文按 1 字 1 token 算，偏保守）
MEMORY_WINDOW_TOKENS=3000
MEMORY_MAX_TURNS=12
# 超出窗口的早期对话压成摘要；关掉就只保留最近几轮，早期内容直接丢弃
MEMORY_SUMMARY_ENABLED=true
# 挤出去的内容攒到多少 token 才压一次。设太小会每轮都多打一次模型，费钱
MEMORY_SUMMARY_TRIGGER_TOKENS=800
# 跨会话的长期记忆（user_memories 表 + remember 工具）
MEMORY_LONGTERM_ENABLED=true

# ---------- ReAct 循环 ----------
# 一次提问最多走几轮「思考 → 动作 → 观测」，走完还没答案就收尾
REACT_MAX_ITERATIONS=10
# 同一工具用同一份参数重复到第几次开始提醒；再多一次直接中断
REACT_LOOP_THRESHOLD=2
# 单条工具结果回灌给模型前的截断长度（字符）
REACT_OBSERVATION_LIMIT=1200

# ---------- 日志 ----------
LOG_LEVEL=INFO
