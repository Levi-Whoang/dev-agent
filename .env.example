# OpenAI-compatible API with streaming and tool calling support.
LLM_API_KEY= api-key
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# MySQL account used by chat sessions and authentication records.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD= mysql-password
MYSQL_DATABASE=agent_demo

# Bundled fictional demo corpus; change this to use your own knowledge files.
KNOWLEDGE_DIR=demo_data/knowledge_base

# 使用 python -c "import secrets; print(secrets.token_urlsafe(48))" 生成随机 JWT 签名密钥。
# JWT 有效期固定为 30 分钟；用户和令牌登记由应用写入 MySQL。
JWT_SECRET_KEY=replace-with-at-least-48-random-characters

# 注册验证码（邀请码）；注册接口要求提交相同值。生产启动时必须设置。
AUTH_REGISTRATION_CODE=123456



# 正式环境须设置 APP_ENV=production；生产启动要求密钥至少 48 字符。
APP_ENV=development
# 启动时预热公共知识库，减少首次检索的冷启动等待。
RAG_WARMUP=true

# Filesystem MCP：目录按登录用户ID隔离，默认位于项目的mcp_workspace下。
MCP_FILESYSTEM_ENABLED=true
MCP_FILESYSTEM_ROOT=mcp_workspace
MCP_FILESYSTEM_ALLOW_WRITE=true
MCP_NODE_COMMAND=node
MCP_TIMEOUT_SECONDS=15
