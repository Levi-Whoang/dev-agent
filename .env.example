# OpenAI-compatible API with streaming and tool calling support.
LLM_API_KEY= api-key
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# 使用 python -m auth.passwords 隐藏输入密码并生成哈希，再配置用户名到哈希的 JSON 映射。
AUTH_USERS_JSON={"demo-user":"replace-with-pbkdf2-hash-generated-by-command"}
# 使用 python -c "import secrets; print(secrets.token_urlsafe(48))" 生成随机密钥。
JWT_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
JWT_EXPIRE_MINUTES=30
# 仅供 scripts/smoke_demo.py 登录；须与 AUTH_USERS_JSON 中的账号对应。
DEMO_AUTH_USERNAME=demo-user
DEMO_AUTH_PASSWORD=replace-with-the-demo-user-password

# MySQL account used by agent/session.py
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD= mysql-password
MYSQL_DATABASE=agent_demo

# Bundled fictional demo corpus; change this to use your own knowledge files.
KNOWLEDGE_DIR=demo_data/knowledge_base
