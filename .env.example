# ===== 大模型服务（OpenAI 兼容）=====
# 模型 API 密钥
LLM_API_KEY=api-key
# 模型接口地址
LLM_BASE_URL=https://api.openai.com/v1
# 调用的模型名称
LLM_MODEL=gpt-4o-mini

# ===== MySQL =====
# 数据库主机
MYSQL_HOST=127.0.0.1
# 数据库端口
MYSQL_PORT=3306
# 数据库用户名
MYSQL_USER=root
# 数据库密码
MYSQL_PASSWORD=mysql-password
# 数据库名
MYSQL_DATABASE=agent_demo

# ===== 知识库 =====
# 知识库目录；默认使用仓库自带的演示语料
KNOWLEDGE_DIR=demo_data/knowledge_base

# ===== 文档解析限制 =====
# Office 压缩包最大条目数
DOCUMENT_MAX_ARCHIVE_ENTRIES=2000
# 解压后总大小上限（字节，默认 200 MB）
DOCUMENT_MAX_UNCOMPRESSED_BYTES=209715200
# PDF/PPTX 最大页数
DOCUMENT_MAX_PAGES=300
# 解析文本最大字符数
DOCUMENT_MAX_CHARS=2000000
# 单次解析超时（秒），超时会终止解析子进程
DOCUMENT_PARSE_TIMEOUT_SECONDS=30

# ===== 认证 =====
# JWT 签名密钥；用 python -c "import secrets; print(secrets.token_urlsafe(48))" 生成
JWT_SECRET_KEY=replace-with-at-least-48-random-characters
# 注册邀请码；注册接口要求提交相同值
AUTH_REGISTRATION_CODE=123456

# ===== 应用 =====
# 运行环境；正式环境设为 production
APP_ENV=development
# 启动时预热知识库，减少首次检索等待
RAG_WARMUP=true

# ===== 历史摘要与上下文预算 =====
# 最近多少轮保留原文
HISTORY_RECENT_TURNS=10
# 发给模型的上下文 token 预算
HISTORY_TOKEN_BUDGET=12000
# 单次摘要的最大 token 数
HISTORY_SUMMARY_MAX_TOKENS=600
# 摘要生成超时（秒）
HISTORY_SUMMARY_TIMEOUT=20

# ===== 超时与重试 =====
# 单轮回答的总超时（秒）
CHAT_TOTAL_TIMEOUT_SECONDS=120
# 单次模型请求超时（秒）
LLM_REQUEST_TIMEOUT_SECONDS=20
# 模型调用最大重试次数
LLM_MAX_RETRIES=2
# 首次重试等待时间（秒）
LLM_RETRY_BACKOFF_SECONDS=0.5
# 重试等待时间上限（秒）
LLM_MAX_RETRY_BACKOFF_SECONDS=4
# 单次工具执行超时（秒）
TOOL_TIMEOUT_SECONDS=15

# ===== Filesystem MCP =====
# 是否启用文件系统 MCP
MCP_FILESYSTEM_ENABLED=true
# MCP 文件根目录；实际按登录用户 ID 隔离
MCP_FILESYSTEM_ROOT=mcp_workspace
# 是否允许写入文件
MCP_FILESYSTEM_ALLOW_WRITE=true
# Node 命令
MCP_NODE_COMMAND=node
# MCP 调用超时（秒）
MCP_TIMEOUT_SECONDS=15
