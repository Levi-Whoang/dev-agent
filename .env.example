# 复制成 .env 后按实际情况填写（.env 已在 .gitignore 中，不会被提交）

# ---------- 大模型（OpenAI 兼容接口） ----------
LLM_API_KEY=sk-xxxx
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT=60

# ---------- 数据库 ----------
# 不填就用项目根目录下的 SQLite（dev_agent.db），开箱即跑
# DATABASE_URL=mysql+aiomysql://root:password@127.0.0.1:3306/agent_db?charset=utf8mb4
DB_ECHO=false

# ---------- 鉴权 ----------
# 生产环境必须换成随机长串，例如 python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720

# ---------- 检索 ----------
KNOWLEDGE_DIR=knowledge_base
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
RAG_TOP_K=3
RAG_DENSE_THRESHOLD=0.55
RAG_DENSE_FLOOR=0.45
RAG_RRF_K=60
RAG_CANDIDATE_POOL=10

# ---------- 日志 ----------
LOG_LEVEL=INFO
